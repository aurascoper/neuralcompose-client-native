{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuralcompose.local/schemas/classifier.schema.json",
  "title": "IntentPrediction",
  "type": "object",
  "required": ["intent", "confidence", "distribution", "windowSequence", "endTimestamp"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["rest", "jawClench", "singleBlink", "doubleBlink", "select"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "distribution": {
      "type": "object",
      "required": ["rest", "jawClench", "singleBlink", "doubleBlink", "select"],
      "properties": {
        "rest": { "type": "number", "minimum": 0, "maximum": 1 },
        "jawClench": { "type": "number", "minimum": 0, "maximum": 1 },
        "singleBlink": { "type": "number", "minimum": 0, "maximum": 1 },
        "doubleBlink": { "type": "number", "minimum": 0, "maximum": 1 },
        "select": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "windowSequence": { "type": "integer", "minimum": 0 },
    "endTimestamp": { "type": "number", "description": "seconds since stream start" }
  },
  "additionalProperties": true
}
