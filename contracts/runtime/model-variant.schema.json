{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelVariant",
  "type": "object",
  "required": ["schemaVersion", "logicalModelId", "variantId", "modelPackId", "runtimeTarget", "artifactFormat", "numericalContractId"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "logicalModelId": { "type": "string", "minLength": 1 },
    "variantId": { "type": "string", "minLength": 1 },
    "modelPackId": { "type": "string", "minLength": 1 },
    "runtimeTarget": { "$ref": "runtime-target.schema.json" },
    "quantization": { "type": ["string", "null"] },
    "artifactFormat": { "type": "string", "minLength": 1 },
    "numericalContractId": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
