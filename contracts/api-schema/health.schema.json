{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuralcompose.local/schemas/health.schema.json",
  "title": "ChannelHealth",
  "description": "Array of per-channel health states. Servers emit the four Muse channels in fixed order TP9, AF7, AF8, TP10.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["channel", "status", "rms", "samples", "timestamp", "lastSampleWallClock"],
    "properties": {
      "channel": { "type": "string", "enum": ["TP9", "AF7", "AF8", "TP10"] },
      "status": { "type": "string", "enum": ["healthy", "saturated", "dead", "unknown"] },
      "rms": { "type": "number", "description": "µV" },
      "samples": { "type": "integer", "minimum": 0 },
      "timestamp": { "type": "number", "description": "seconds since stream start" },
      "lastSampleWallClock": { "type": "number", "description": "unix seconds" }
    },
    "additionalProperties": true
  }
}
