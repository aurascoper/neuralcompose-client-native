<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext ws:// permitted ONLY for the loopback dev stub (reached on the
     device via `adb reverse tcp:8787 tcp:8787`) and the emulator host alias.
     Production endpoints use TLS; no global cleartext, no broad exemption. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
