{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelPackCatalogEntry",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "packVersion",
    "kind",
    "modelFamily",
    "modelRevision",
    "artifactFormat",
    "licenseId",
    "sourceRepository",
    "runtimeAbi",
    "minimumCoreVersion",
    "artifacts",
    "requirements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "packVersion": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "generation",
        "embedding"
      ]
    },
    "modelFamily": {
      "type": "string"
    },
    "modelRevision": {
      "type": "string"
    },
    "quantization": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifactFormat": {
      "type": "string"
    },
    "licenseId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRepository": {
      "type": "string"
    },
    "runtimeAbi": {
      "type": "string"
    },
    "minimumCoreVersion": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifactId",
          "kind",
          "relativePath",
          "byteSize",
          "sha256Hex"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "weights",
              "tokenizer",
              "config",
              "auxiliary"
            ]
          },
          "relativePath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0
          },
          "sha256Hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "object",
      "required": [
        "minimumRamMb",
        "deviceClass"
      ],
      "properties": {
        "minimumRamMb": {
          "type": "integer"
        },
        "deviceClass": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "generation": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "tokenizerId",
        "contextCap",
        "promptTemplateId",
        "compatiblePromptProfiles"
      ],
      "properties": {
        "tokenizerId": {
          "type": "string"
        },
        "contextCap": {
          "type": "integer",
          "minimum": 1
        },
        "promptTemplateId": {
          "type": "string"
        },
        "compatiblePromptProfiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "embedding": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "tokenizerId",
        "dimensions",
        "pooling",
        "normalization"
      ],
      "properties": {
        "tokenizerId": {
          "type": "string"
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1
        },
        "pooling": {
          "enum": [
            "mean",
            "cls",
            "lastToken"
          ]
        },
        "normalization": {
          "enum": [
            "none",
            "l2"
          ]
        },
        "taskInstruction": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "generation"
          }
        }
      },
      "then": {
        "required": [
          "generation"
        ],
        "properties": {
          "embedding": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "embedding"
          }
        }
      },
      "then": {
        "required": [
          "embedding"
        ],
        "properties": {
          "generation": {
            "type": "null"
          }
        }
      }
    }
  ]
}