{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuralcompose.local/schemas/diagnostics.schema.json",
  "title": "StreamDiagnostics",
  "type": "object",
  "required": [
    "transport", "sampleRate", "packetsReceived", "packetsDropped",
    "packetLossEstimate", "packetJitterMillis", "lastInterArrivalMillis",
    "lastHeartbeat", "boundPort", "localInterfaceName"
  ],
  "properties": {
    "transport": {
      "type": "string",
      "enum": ["OSC (Mind Monitor)", "BrainFlow (BLE)", "Playback", "Synthetic", "Unknown"]
    },
    "sampleRate": { "type": "number" },
    "packetsReceived": { "type": "integer", "minimum": 0 },
    "packetsDropped": { "type": "integer", "minimum": 0 },
    "packetLossEstimate": { "type": ["number", "null"] },
    "packetJitterMillis": { "type": "number" },
    "lastInterArrivalMillis": { "type": "number" },
    "lastHeartbeat": { "type": "string", "description": "ISO 8601" },
    "boundPort": { "type": "integer" },
    "localInterfaceName": { "type": "string" }
  },
  "additionalProperties": true
}
