/target
node_modules/
.DS_Store
*.xcframework
ios/Generated/
ios/Frameworks/
# Gradle/Android build state — never source history. The wrapper jar IS committed.
android/**/.gradle/
android/**/build/
android/**/src/main/jniLibs/
local.properties
# xcodegen output — regenerate with `xcodegen generate` in ios/NeuralComposeClient
*.xcodeproj/
*.dylib
*.a
*.so
.kotlin/

# Generated by xcodegen from project.yml (which is the source of truth,
# including the ATS posture) — regenerated on every `xcodegen generate`.
ios/NeuralComposeClient/Info.plist

# Bridge tool environments (derived; see each tool's README)
tools/muse-ble-bridge/.venv/
tools/muse-osc-bridge/node_modules
tools/spoken-loop/.venv/

# Agent scratch. Present in the working tree since before 2026-08-03 but never
# committed, so it protected one machine and no other checkout. Committed
# because these are written into whatever repo an agent is launched from, and
# two hosts writing artifacts into two checkouts of related work is the ledger
# fork one level up — divergent artifacts with separate provenance and no
# append-only gate to catch them.
.pi-subagents/
outputs/

# Model artifacts. Today's exports live at ~/models/onnx, outside this worktree,
# so nothing here is currently at risk — this is preventive, on the 64f2332
# reasoning: a path that stays uncommitted because of where it happens to sit
# protects one machine and no other checkout. tools/onnx/README.md tells a
# reader to produce two 133 MB .onnx files, and nothing stops them producing
# them here. Both rebuild from the pinned revision, so they are derived, not
# evidence, and must never enter the ledger.
*.onnx
*.onnx.data
*.gguf
*.safetensors
models/

# Throwaway venvs for the one-shot ONNX inventory (tools/onnx/README.md).
onnxenv/
__pycache__/
