{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimePackManifest",
  "type": "object",
  "required": ["schemaVersion", "runtimePackId", "version", "target", "libraries", "licenses", "entrypoints", "runtimeAbi"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtimePackId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "target": { "$ref": "runtime-target.schema.json" },
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["libraryId", "relativePath", "byteSize", "sha256Hex"],
        "properties": {
          "libraryId": { "type": "string", "minLength": 1 },
          "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$" },
          "byteSize": { "type": "integer", "minimum": 1 },
          "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "licenses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entrypointId", "libraryId", "symbol"],
        "properties": {
          "entrypointId": { "type": "string", "minLength": 1 },
          "libraryId": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "runtimeAbi": { "type": "string", "minLength": 1 },
    "signingIdentity": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
